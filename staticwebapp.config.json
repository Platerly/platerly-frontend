{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/static/*",
      "/s/*",
      "/og/*"
    ]
  },
  "routes": [
    {
      "route": "/s/*",
      "serve": "/api/share/recipe/*",
      "statusCode": 200
    },
    {
      "route": "/og/recipe/*",
      "serve": "/api/share/og/recipe/*",
      "statusCode": 200
    },
    {
      "route": "/sitemap.xml",
      "redirect": "https://platerly-api-g9htcadmbda6h8ej.canadacentral-01.azurewebsites.net/sitemap.xml",
      "statusCode": 301
    }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/index.html", "statusCode": 200 }
  }
}
