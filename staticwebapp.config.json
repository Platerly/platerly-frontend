{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/static/*"
    ]
  },
  "routes": [
    {
      "route": "/api",
      "rewrite": "/index.html"
    }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/index.html", "statusCode": 200 }
  }
}
