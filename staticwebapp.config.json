{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/static/*",
      "/s/*"
    ]
  },
  "routes": [
    {
      "route": "/s/*",
      "serve": "/api/share/recipe/*",
      "statusCode": 200
    }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/index.html", "statusCode": 200 }
  }
}