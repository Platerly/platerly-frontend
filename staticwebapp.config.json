{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/Share/*", 
      "/og/*",
      "/api/*",
      "/assets/*",
      "/static/*"
    ]
  },
  "responseOverrides": {
    "404": { "rewrite": "/index.html", "statusCode": 200 }
  },
  "routes": [
    {
      "route": "/s/:id",
      "rewrite": "/api/Share/recipe/:id",
      "allowedRoles": ["anonymous"]
    }
  ]
}
