{
  "routes": [
    {
      "route": "/*",
      "redirect": "https://platerly.com/{path}{query}",
      "statusCode": 301,
      "conditions": { "host": "www.platerly.com" }
    }
  ],
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/api/*", "/assets/*"] },
  "globalHeaders": { "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload" }
}
